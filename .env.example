# Copy this file to .env and fill in your own values.
#   PowerShell:  Copy-Item .env.example .env

# Your friend's phone number in international format: + country code + number.
# Spaces and dashes are allowed. Example (India): +91 98765 43210
FRIEND_PHONE=+10000000000

# How often (in minutes) to bring your friend's chat back to the front.
# Allowed range: 1 to 1440. Default: 5
INTERVAL_MINUTES=5

# true  = click the voice-call button automatically at each interval
# false = only open the chat and remind you to call (default)
AUTO_CALL=true

# Safety cap: maximum automatic call attempts per run (1 or more). Default: 3
# After this, the program falls back to reminders only.
MAX_CALLS=3

# Optional email alert when your friend answers. Leave EMAIL_TO empty to turn it off.
# SMTP_USER: the Gmail address that sends the email.
# SMTP_PASS: a Gmail App Password (NOT your normal password) - see README.
EMAIL_TO=
SMTP_USER=
SMTP_PASS=

# Optional WhatsApp alert: this number gets a message from your account
# after an answered call ends (it can't be sent during the call).
NOTIFY_PHONE=

# Optional: full path to chrome.exe if Chrome is installed in an unusual place.
# Leave empty to use the normally installed Google Chrome.
CHROME_PATH=
